load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@zenoh_c_crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(["Cargo.toml", "Cargo.lock"])

# The zenoh-c default features plus the ones rmw_zenoh_cpp needs. Keep in sync
# with zenoh_c.patch and generate_opaque_types.sh.
ZENOHC_FEATURES = [
    "auth_pubkey",
    "auth_usrpwd",
    "default",
    "shared-memory",
    "transport_compression",
    "transport_multilink",
    "transport_quic",
    "transport_serial",
    "transport_tcp",
    "transport_tls",
    "transport_udp",
    "transport_unixsock-stream",
    "transport_ws",
    "unstable",
]

TARGET_TRIPLES = [
    "aarch64-unknown-linux-gnu",
    "x86_64-unknown-linux-gnu",
]

# Upstream build.rs generates these by compiling build-resources/opaque-types,
# which Bazel cannot do, so checked-in copies are used per target triple. See
# //ros2/zenoh_c:generate_opaque_types.sh.
[
    genrule(
        name = name,
        srcs = select({
            "@rules_rs//rs/platforms/config:" + triple: ["@hermetic_ros//ros2/zenoh_c:" + src.format(triple)]
            for triple in TARGET_TRIPLES
        }),
        outs = [out],
        cmd = "cp $< $@",
    )
    for name, src, out in [
        ("opaque_types_rs", "opaque_types_{}.rs", "src/opaque_types/opaque_types.rs"),
        ("zenoh_configure_h", "zenoh_configure_{}.h", "include/zenoh_configure.h"),
        ("zenoh_opaque_h", "zenoh_opaque_{}.h", "include/zenoh_opaque.h"),
    ]
]

rust_shared_library(
    name = "zenohc_rs",
    srcs = glob(["src/**/*.rs"]) + [":opaque_types_rs"],
    crate_features = ZENOHC_FEATURES,
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = ["-Clink-arg=-Wl,-soname,libzenohc.so"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

cc_library(
    name = "zenohc",
    hdrs = glob(["include/*.h"]) + [
        ":zenoh_configure_h",
        ":zenoh_opaque_h",
    ],
    includes = ["include"],
    deps = [":zenohc_rs"],
    visibility = ["//visibility:public"],
)
