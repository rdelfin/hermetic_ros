build --bes_results_url=https://app.buildbuddy.io/invocation/
build --bes_backend=grpcs://remote.buildbuddy.io
common --remote_cache=grpcs://remote.buildbuddy.io
common --remote_timeout=10m

common --remote_cache_compression
common --remote_grpc_log=bazel-remote-grpc.log
common--execution_log_compact_file=execution_log.binpb.zst
common --experimental_remote_cache_chunking
common --noslim_profile
common --experimental_profile_include_target_label
common --experimental_profile_include_primary_output
build --workspace_status_command=$(pwd)/tools/bazel/workspace_status.sh

try-import %workspace%/user.bazelrc
